{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    // DOM as well as node: the tests configure node, but almost every assertion runs code
    // inside the page, where document and HTMLElement are the whole point.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    // The same bar as the app. A test that indexes into a locator result and gets undefined
    // should be a compile error, not a confusing timeout.
    "noUncheckedIndexedAccess": true,

    "strict": true
  },
  "include": ["e2e", "playwright.config.ts"]
}
